# --- Postgres ---
POSTGRES_USER=reports
POSTGRES_PASSWORD=reports
POSTGRES_DB=reports
DATABASE_URL=postgresql+psycopg://reports:reports@db:5432/reports

# --- RustFS (S3-compatible object storage) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=reports

# --- App ---
# 32+ byte secret; used to derive the Fernet key that encrypts integration credentials
# from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
SECRET_KEY=change-me-32-byte-dev-secret-key!
RUN_SCHEDULER=true
SYNC_INTERVAL_MINUTES=60

# --- Per-commit code analysis (LLM) ---
# Only "claude_cli" is implemented (Claude Code CLI). Auth: run
# `docker compose run --rm app claude setup-token`, then either paste the printed
# token into the Provider tab (stored in the claude_config volume) or set it here.
DEFAULT_ANALYSIS_PROVIDER=claude_cli
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CLAUDE_MODEL=            # optional; passed to the CLI as --model
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_MAX_DIFF_BYTES=60000

# --- Integration credentials are stored per-project in the DB (encrypted), ---
# --- not here. These are only defaults for local experimentation, if needed. ---

JIRA_API_TOKEN=jira-token-here
